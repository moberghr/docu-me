<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Central Package Management requires an unambiguous source: with more than one
    feed configured (machine-level nuget.org + a private feed), NuGet raises NU1507,
    which TreatWarningsAsErrors turns into a build error. DocuMe depends only on
    public packages, so we clear inherited sources and pin nuget.org. This also
    makes restore deterministic in CI, which has no access to any private feed.

    When a private Moberg package (e.g. Moberg.Warp.*) is first referenced, add its
    feed here and switch to <packageSourceMapping> to route by package-id pattern.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
