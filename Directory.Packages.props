<Project>

  <!-- Central Package Management (Moberg house standard): the single source of truth
       for every package version. PackageReference entries in the .csproj files carry
       no inline Version= attribute. See .claude/references/dotnet/moberg-house-standards.md. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime dependencies (PLAN.md §4). -->
  <ItemGroup>
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <!-- Analyzers (max-strict house set, versions mirrored from app-templates
       fullstack-app/backend-server/Directory.Packages.props). StyleCop's 1.2.0-beta is the
       de-facto current release (its last "stable" 1.1.118 predates modern analyzer infra). -->
  <ItemGroup>
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.27.0.140913" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.112" />
  </ItemGroup>

  <!-- Test dependencies (PLAN.md §4): xUnit + Shouldly + NSubstitute.
       xunit.v3.mtp-v2 is the single house test package (app-templates pin): xUnit v3 running
       on the Microsoft Testing Platform, replacing v2's xunit + xunit.runner.visualstudio +
       Microsoft.NET.Test.Sdk trio. coverlet.collector is deliberately absent: it is a VSTest
       data collector and does not run under MTP (use Microsoft.Testing.Extensions.CodeCoverage
       if coverage is ever needed). -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

</Project>
