<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Single version across CLI, Core, plugin, action (PLAN.md §12). -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!-- Package metadata shared by both packable projects (PLAN.md §12). RepositoryUrl is what makes
       GitHub Packages attach the pushed package to this repository rather than leaving it floating
       under the owner; without it the package publishes but its page links nowhere. -->
  <PropertyGroup>
    <Authors>Moberg</Authors>
    <Company>Moberg</Company>
    <PackageProjectUrl>https://github.com/moberghr/docu-me</PackageProjectUrl>
    <RepositoryUrl>https://github.com/moberghr/docu-me</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Maximum-strict analysis (Moberg house standard). Analyzer-rule severities, and the small
       set we intentionally relax, live in .editorconfig — root for global rules, per-project
       globs for tests. See .claude/references/dotnet/moberg-house-standards.md. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for the documentation analyzers to run at all. Without a documentation file the
         compiler parses doc comments with DocumentationMode.None, so SA1604/SA1642/RCS1139 and the
         compiler's own cref validation (CS1574/CS0419) silently never fire — the build reported zero
         warnings while `dotnet format` found real defects. StyleCop says so via SA0001, which is
         kept at warning below so dropping this property fails the build instead of going quiet. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep NuGet audit ON and visible (NuGetAuditMode=all surfaces transitive advisories), but
         don't fail the build on advisories in transitive packages we can't directly patch. Bump the
         owning direct dependency when a fix ships. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Analyzers applied to every project (PrivateAssets=all so they don't flow downstream). -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>
